[Unit]
Description=Zen Proxy WARP relay (HTTP CONNECT relay with a direct fallback)
Documentation=https://github.com/12errh/zen-proxy
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/.zen-proxy
ExecStart=/usr/bin/node /home/agent/.zen-proxy/scripts/warp-relay.mjs --port 8890 --hop http://127.0.0.1:40000 --fallback direct --summary-seconds 60
Restart=always
RestartSec=2
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
